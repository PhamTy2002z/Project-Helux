# Root compose defaults (safe for local self-host / dev).
# Copy to `.env` for local compose.
#
# Production:
# - Prefer `compose.prod.yml` with a dedicated `.env.prod`.
# - Required for compose.prod: DOMAIN, GHCR_IMAGE_TAG, POSTGRES_PASSWORD,
#   MINIO_ROOT_PASSWORD, LOCAL_AUTH_TOKEN.
# - If invite email enabled: RESEND_API_KEY + EMAIL_FROM_INVITES +
#   INVITE_ACCEPT_BASE_URL.

# --- app ports (host) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- production image + domain (compose.prod.yml) ---
# DOMAIN=flowgrid.live
# GHCR_OWNER=phamty2002z
# GHCR_IMAGE_TAG=latest

# --- database ---
POSTGRES_DB=mission_control
POSTGRES_USER=postgres
# CHANGE in production.
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- object storage (MinIO) ---
# Set strong credentials in production.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Shared bucket used by backend + worker for board chat file storage.
OBJECT_STORAGE_BUCKET=board-chat-files

# --- backend settings (see backend/.env.example for full list) ---
# For remote access, set this to your UI origin (e.g. http://<server-ip>:3000 or https://mc.example.com).
CORS_ORIGINS=http://localhost:3000
# For production:
# CORS_ORIGINS=https://flowgrid.live
DB_AUTO_MIGRATE=true
LOG_LEVEL=INFO
REQUEST_LOG_SLOW_MS=1000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_LIMIT_PER_MINUTE=240
RATE_LIMIT_ACTOR_LIMIT_PER_MINUTE=480
BILLING_MODE=simulated
PAYMENT_PROVIDER=none
# --- Polar Payment Provider (only when PAYMENT_PROVIDER=polar) ---
# POLAR_ACCESS_TOKEN=polar_at_xxx
# POLAR_WEBHOOK_SECRET=whsec_xxx
# POLAR_PRODUCT_ID_PRO=prod_xxx
# POLAR_ENVIRONMENT=sandbox
# POLAR_SUCCESS_URL=http://localhost:3000/checkout/success?checkout_id={CHECKOUT_ID}
# --- Invite Email Provider (organization invite delivery only) ---
# EMAIL_PROVIDER=none|resend
EMAIL_PROVIDER=none
# RESEND_API_KEY=re_xxx
# RESEND_WEBHOOK_SECRET=whsec_xxx
# EMAIL_FROM_INVITES=FlowGrid <noreply@flowgrid.live>
# EMAIL_REPLY_TO=support@flowgrid.live
# INVITE_ACCEPT_BASE_URL=http://localhost:3000/invite
# Production invite URL:
# INVITE_ACCEPT_BASE_URL=https://flowgrid.live/invite
READINESS_CHECK_TIMEOUT_SECONDS=1.5
READINESS_WORKER_HEARTBEAT_KEY=mission-control:worker:heartbeat
READINESS_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
WORKER_HEARTBEAT_KEY=mission-control:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=300
MANAGED_GATEWAY_AUTO_PROVISION=true
MANAGED_GATEWAY_URL=ws://127.0.0.1:18789/ws
# Set this token to avoid first-time manual device pairing.
MANAGED_GATEWAY_TOKEN=
MANAGED_GATEWAY_WORKSPACE_ROOT=~/.openclaw/managed
OPENCLAW_USAGE_ENFORCEMENT_MODE=observe
OPENCLAW_USAGE_CAPABILITY_TTL_SECONDS=300
# Auth profile: dev, self_hosted, or saas.
AUTH_PROFILE=self_hosted
AUTH_MODE=local
# REQUIRED when AUTH_MODE=local (must be non-placeholder and at least 50 chars).
LOCAL_AUTH_TOKEN=

# --- frontend settings ---
# REQUIRED: Public URL used by the browser to reach the API.
# Use `auto` to target the same host currently serving Mission Control on port 8000.
# Example (explicit override): NEXT_PUBLIC_API_URL=https://mc.example.com
NEXT_PUBLIC_API_URL=auto
