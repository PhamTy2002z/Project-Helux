# Backend defaults for local development.
# For production, set ENVIRONMENT=production and provide non-default secrets.

# --- General ---
ENVIRONMENT=dev

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_USE_UTC=false
REQUEST_LOG_SLOW_MS=1000
REQUEST_LOG_INCLUDE_HEALTH=false

# --- API rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREFIX=api-rl
RATE_LIMIT_IP_LIMIT_PER_MINUTE=240
RATE_LIMIT_ACTOR_LIMIT_PER_MINUTE=480

# --- Billing & payments ---
BILLING_MODE=simulated
PAYMENT_PROVIDER=none
# Polar (only when PAYMENT_PROVIDER=polar):
# POLAR_ACCESS_TOKEN=polar_at_xxx
# POLAR_WEBHOOK_SECRET=whsec_xxx
# POLAR_PRODUCT_ID_PRO=prod_xxx
# POLAR_ENVIRONMENT=sandbox
# POLAR_SUCCESS_URL=http://localhost:3000/checkout/success?checkout_id={CHECKOUT_ID}

# --- Invite email (organization invite delivery only) ---
# EMAIL_PROVIDER=none|resend
EMAIL_PROVIDER=none
# RESEND_API_KEY=re_xxx
# RESEND_WEBHOOK_SECRET=whsec_xxx
# EMAIL_FROM_INVITES=FlowGrid <noreply@example.com>
# EMAIL_REPLY_TO=support@example.com
# INVITE_ACCEPT_BASE_URL=http://localhost:3000/invite

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mission_control
# Auto-migrate: defaults to true in dev environment (see config.py _defaults).
DB_AUTO_MIGRATE=false

# --- Auth ---
# Auth profile: dev, self_hosted, or saas.
AUTH_PROFILE=self_hosted
# Auth mode: clerk or local.
AUTH_MODE=local
# REQUIRED when AUTH_MODE=local (must be non-placeholder and at least 50 chars).
LOCAL_AUTH_TOKEN=
# Clerk (used when AUTH_MODE=clerk):
CLERK_SECRET_KEY=
CLERK_API_URL=https://api.clerk.com
CLERK_VERIFY_IAT=true
CLERK_LEEWAY=10.0
# Clerk webhook secret for Svix signature verification (user.created → welcome email).
# Obtain from Clerk Dashboard → Webhooks → Signing Secret.
# CLERK_WEBHOOK_SECRET=whsec_xxx

# --- CORS & base URL ---
# For remote access, set this to your UI origin (e.g. http://<server-ip>:3000).
CORS_ORIGINS=http://localhost:3000
# REQUIRED: absolute URL reachable by gateway runtime.
BASE_URL=

# --- Security response headers (blank disables each header) ---
SECURITY_HEADER_X_CONTENT_TYPE_OPTIONS=
SECURITY_HEADER_X_FRAME_OPTIONS=
SECURITY_HEADER_REFERRER_POLICY=
SECURITY_HEADER_PERMISSIONS_POLICY=

# --- Redis / RQ queue ---
RQ_REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=default
RQ_DISPATCH_THROTTLE_SECONDS=15.0
RQ_DISPATCH_MAX_RETRIES=3
RQ_DISPATCH_RETRY_BASE_SECONDS=10.0
RQ_DISPATCH_RETRY_MAX_SECONDS=120.0

# --- Worker & readiness ---
WORKER_HEARTBEAT_KEY=mission-control:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=300
READINESS_CHECK_TIMEOUT_SECONDS=1.5
READINESS_WORKER_HEARTBEAT_KEY=mission-control:worker:heartbeat
READINESS_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

# --- OpenClaw gateway ---
GATEWAY_MIN_VERSION=2026.02.9
GATEWAY_RPC_CONNECT_TIMEOUT_SECONDS=10.0
GATEWAY_RPC_RESPONSE_TIMEOUT_SECONDS=20.0
OPENCLAW_USAGE_ENFORCEMENT_MODE=observe
OPENCLAW_USAGE_CAPABILITY_TTL_SECONDS=300
OPENCLAW_USAGE_UTC_OFFSET=UTC+7
OPENCLAW_USAGE_DAY_TIMEZONE=Asia/Ho_Chi_Minh
GATEWAY_LIFECYCLE_TIMEOUT_SECONDS=90.0

# --- SaaS / shared gateway (legacy — prefer MANAGED_GATEWAY_* for new deploys) ---
SAAS_MODE=false
SHARED_GATEWAY_URL=
SHARED_GATEWAY_TOKEN=
SHARED_GATEWAY_WORKSPACE_BASE=

# --- Managed gateway ---
MANAGED_GATEWAY_AUTO_PROVISION=true
MANAGED_GATEWAY_NAME=Managed Gateway
MANAGED_GATEWAY_URL=ws://127.0.0.1:18789/ws
# Set this token to avoid first-time manual device pairing.
MANAGED_GATEWAY_TOKEN=
MANAGED_GATEWAY_WORKSPACE_ROOT=~/.openclaw/managed
MANAGED_GATEWAY_DISABLE_DEVICE_PAIRING=false
MANAGED_GATEWAY_ALLOW_INSECURE_TLS=false

# --- Board planning overlay (feature flags) ---
BOARD_PLANNING_OVERLAY_V1=false
# BOARD_PLANNING_OVERLAY_V1_CANARY_BOARD_IDS=
# BOARD_PLANNING_OVERLAY_V1_CANARY_ORG_IDS=
BOARD_QUERY_V2=false
# BOARD_QUERY_V2_CANARY_BOARD_IDS=
# BOARD_QUERY_V2_CANARY_ORG_IDS=

# --- Object storage (MinIO / S3-compatible) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=board-chat-files
OBJECT_STORAGE_USE_SSL=false

# --- Board chat file upload limits ---
BOARD_CHAT_FILE_MAX_BYTES=10485760
BOARD_CHAT_FILE_MAX_PER_MESSAGE=3
BOARD_CHAT_FILE_PREVIEW_MAX_CHARS=500
BOARD_CHAT_FILE_ALLOWED_TYPES=txt,md,csv,json,pdf
BOARD_CHAT_FILE_PDF_OCR_ENABLED=true
BOARD_CHAT_FILE_PDF_OCR_LANG=eng+vie
BOARD_CHAT_FILE_PDF_OCR_MAX_PAGES=12
BOARD_CHAT_FILE_PDF_OCR_RENDER_SCALE=2.0

# --- Board chat file report SLA / retry ---
BOARD_CHAT_FILE_REPORT_TIMEOUT_SECONDS=300
BOARD_CHAT_FILE_REPORT_MAX_RETRIES=2
BOARD_CHAT_FILE_REPORT_RETRY_BACKOFF_SECONDS=30,120

# --- Shared knowledge publication ---
BOARD_CHAT_FILE_PUBLISH_GROUP_MEMORY=false
