        } else {
          failures.push(boardId);
        }
      } catch {
        failures.push(boardId);
      }
    }

    setAssignmentsResult({ updated, failed: failures.length });
    if (failures.length > 0) {
      setAssignmentsError(
        `Failed to update ${failures.length} board assignment${
          failures.length === 1 ? "" : "s"
