                ) : null}
              </div>
              {postCommentError ? (
                <p className="text-xs text-rose-600">{postCommentError}</p>
              ) : null}
              {!canWrite ? (
                <p className="text-xs text-slate-500">
                  Read-only access. You cannot post comments on this board.
