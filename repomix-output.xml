                  </footer>
                </motion.blockquote>
              ))}
            </motion.div>
          </AnimatePresence>

          {filtered.length === 0 && (
            <div className="hero-glass-card rounded-2xl border border-white/10 px-6 py-16 text-center text-sm text-white/40">
              No testimonials in this category yet.
            </div>
          )}
        </div>
      </section>
    </>
  );
}
