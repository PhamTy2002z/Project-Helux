                    ? "h-2 w-7 border-white bg-white"
                    : "h-2 w-2 border-white/30 bg-white/20 hover:border-white/50 hover:bg-white/40"
                }`}
              />
            </button>
          ))}
        </div>
      </div>
    </section>
  );
}
