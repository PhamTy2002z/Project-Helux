                      setCommentDraft(nextValue);
                      refreshMentionTarget(
                        nextValue,
                        event.target.selectionStart ?? nextValue.length,
                      );
                    }}
                    onClick={(event) => {
                      refreshMentionTarget(
                        commentDraft,
                        event.currentTarget.selectionStart ?? commentDraft.length,
                      );
