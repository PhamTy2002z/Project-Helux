            "idempotent_replay": result.idempotent_replay,
        },
    )
    record_admin_audit(
        session,
        audit_action="billing.simulate.checkout",
        endpoint="/api/v1/billing/simulate/checkout",
        organization_id=ctx.organization.id,
        actor_id=ctx.member.user_id,
