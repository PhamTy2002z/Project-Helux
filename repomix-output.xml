      </header>
      <div
        className="grid min-h-[calc(100vh-64px)] bg-slate-50 transition-[grid-template-columns] duration-200 ease-in-out"
        style={{
          gridTemplateColumns: collapsed ? "0px 1fr" : "260px 1fr",
        }}
      >
        {children}
      </div>
    </div>
  );
}

export function DashboardShell({ children }: { children: ReactNode }) {
  const pathname = usePathname();
  const isOnboardingPath = pathname.startsWith("/onboarding");

  useOnboardingGuard(isOnboardingPath);

  useEffect(() => {
    if (typeof window === "undefined") return;

    const handleStorage = (event: StorageEvent) => {
      if (event.key !== "openclaw_org_switch" || !event.newValue) return;
      window.location.reload();
    };

    window.addEventListener("storage", handleStorage);

    let channel: BroadcastChannel | null = null;
    if ("BroadcastChannel" in window) {
      channel = new BroadcastChannel("org-switch");
      channel.onmessage = () => {
        window.location.reload();
      };
    }

    return () => {
      window.removeEventListener("storage", handleStorage);
      channel?.close();
    };
  }, []);

  return (
    <SidebarCollapseProvider>
      <ShellInner>{children}</ShellInner>
    </SidebarCollapseProvider>
  );
}
