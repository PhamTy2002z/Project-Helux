# Frontend defaults for local development.
# Copy to `.env.local` and adjust as needed.

# --- API ---
# Public URL used by the browser to reach the API.
# Use `auto` to target the same host currently serving VisgniteAI on port 8000.
# Example explicit override: https://visgnite.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public canonical site URL used for metadata, sitemap, and robots host.
# Example: https://visgnite.com
NEXT_PUBLIC_SITE_URL=https://visgnite.com

# --- Auth ---
# Auth profile: dev, self_hosted, or saas.
NEXT_PUBLIC_AUTH_PROFILE=self_hosted
# Auth mode: clerk or local.
# - clerk: Clerk sign-in flow
# - local: shared bearer token entered in UI
NEXT_PUBLIC_AUTH_MODE=local

# --- Clerk auth (used when NEXT_PUBLIC_AUTH_MODE=clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
CLERK_SECRET_KEY=

# --- Managed gateway (passed through to backend via compose) ---
MANAGED_GATEWAY_AUTO_PROVISION=true
MANAGED_GATEWAY_DISABLE_DEVICE_PAIRING=false
MANAGED_GATEWAY_TOKEN=
MANAGED_GATEWAY_URL=ws://127.0.0.1:18789/ws
MANAGED_GATEWAY_WORKSPACE_ROOT=~/.openclaw/managed
