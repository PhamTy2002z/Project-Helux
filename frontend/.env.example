# Frontend defaults for local development.
# Copy to `.env.local` and adjust as needed.

# --- API ---
# Public URL used by the browser to reach the API.
# Use `auto` to target the same host currently serving FlowGrid on port 8000.
# Example explicit override: https://flowgrid.live
NEXT_PUBLIC_API_URL=auto

# Public canonical site URL used for metadata, sitemap, and robots host.
# Example: https://flowgrid.live
NEXT_PUBLIC_SITE_URL=https://flowgrid.live

# --- Auth ---
# Auth profile: dev, self_hosted, or saas.
NEXT_PUBLIC_AUTH_PROFILE=self_hosted
# Auth mode: clerk or local.
# - clerk: Clerk sign-in flow
# - local: shared bearer token entered in UI
NEXT_PUBLIC_AUTH_MODE=local

# --- Clerk auth (used when NEXT_PUBLIC_AUTH_MODE=clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/boards
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
